#. (itstool) path: section/title
#: en/chapters/admin_guide.xml:1927
msgid "Global Permissions"
msgstr "Permissions globales"

#. (itstool) path: section/para
#: en/chapters/admin_guide.xml:1928
msgid ""
"These affect the whole board and are not bound to specific forums. They "
