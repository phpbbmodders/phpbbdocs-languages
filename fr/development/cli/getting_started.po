msgid "``--quiet, -q``"
msgstr "``--quiet, -q``"

#: ../../devdocs-source-copy/cli/getting_started.rst:1
msgid "Do not output any message"
msgstr "N'affiche aucun message"

#: ../../devdocs-source-copy/cli/getting_started.rst:1
msgid "``--verbose, -v, -vv, -vvv``"
msgstr "``--verbose, -v, -vv, -vvv``"

#: ../../devdocs-source-copy/cli/getting_started.rst:1
msgid ""
"Increase the verbosity of messages: 1 for normal output, 2 for more verbose "
"output and 3 for debug"
msgstr ""
"Augmente le niveau de détail des messages : 1 pour une sortie normale, 2 "
"pour une sortie plus détaillée et 3 pour le débogage"

#: ../../devdocs-source-copy/cli/getting_started.rst:1
msgid "``--version, -V``"
msgstr "``--version, -V``"

#: ../../devdocs-source-copy/cli/getting_started.rst:1
