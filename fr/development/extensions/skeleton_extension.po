#: ../../devdocs-source-copy/extensions/skeleton_extension.rst:412
msgid "User control panel (UCP)"
msgstr "Panneau de contrôle utilisateur (UCP)"

#: ../../devdocs-source-copy/extensions/skeleton_extension.rst:414
