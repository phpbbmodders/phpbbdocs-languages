msgstr "standard []"

#: ../../devdocs-source-copy/migrations/tools/module.rst:1
msgid ""
"An array of the data on the new module. This can be setup in two different "
"ways. (see below)"
msgstr ""
"Et array med data om det nye modul. Dette kan opsættes på to forskellige "
"måder. (se nedenfor)"

#: ../../devdocs-source-copy/migrations/tools/module.rst:1
msgid "include_path"
msgstr "include_path"

#: ../../devdocs-source-copy/migrations/tools/module.rst:1
