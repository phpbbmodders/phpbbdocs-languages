#. (itstool) path: section/para
#: admin_guide.xml:1343
msgid ""
"To delete the avatar image, simply check the <guilabel>Delete "
"image</guilabel> checkbox underneath the avatar image."
msgstr ""
"For at slette avatarbilledet, markér blot afkrydsningsfeltet <guilabel>Slet "
