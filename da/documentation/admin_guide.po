msgstr ""
"<guilabel>Uploadmappe</guilabel>: Den mappe, vedhæftede filer uploades til. "
"Standardmappen er <filename>/files/</filename>."

#. (itstool) path: listitem/para
#: admin_guide.xml:1051
msgid ""
"<guilabel>Attachment display order</guilabel>: The order that attachments "
"will be displayed, based on the time the attachment was posted."
msgstr ""
"<guilabel>Visningsrækkefølge for vedhæftede filer</guilabel>: Den "
"rækkefølge, vedhæftede filer vises i, baseret på tidspunktet den vedhæftede "
"fil blev postet."

#. (itstool) path: listitem/para
#: admin_guide.xml:1052
msgid ""
"<guilabel>Total attachment quota</guilabel>: The maximum drive space that "
"will be available for all of your board's attachments. If you want this "
"quota to be unlimited, use a value of 0."
msgstr ""
"<guilabel>Samlet kvote for vedhæftede filer</guilabel>: Den maksimale "
