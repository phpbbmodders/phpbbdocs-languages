msgstr "<guilabel>Slet</guilabel>: Sletter de valgte emner."

#. (itstool) path: listitem/para
#: moderator_guide.xml:391
msgid ""
"<guilabel>Restore</guilabel>: Restores the selected soft-deleted topic(s)."
msgstr ""
"<guilabel>Gendan</guilabel>: Gendanner de valgte, blødt slettede emner."

#. (itstool) path: listitem/para
#: moderator_guide.xml:392
msgid ""
"<guilabel>Move</guilabel>: Moves the selected topic(s) to another forum of "
