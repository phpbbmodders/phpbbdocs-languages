#. (itstool) path: varlistentry/term
#: en/chapters/admin_guide.xml:1848
msgid "Group private message limit per folder"
msgstr "Limit an Privaten Nachrichten pro Ordner für diese Gruppe"

#. (itstool) path: listitem/para
#: en/chapters/admin_guide.xml:1849
msgid ""
"This setting overrides the per-user folder message limit. A value of \"0\" "
