msgstr "A URL pointing to the website of the author."

#: ../../devdocs-source-copy/extensions/tutorial_basics.rst:1
msgid "``role``"
msgstr "``role``"

#: ../../devdocs-source-copy/extensions/tutorial_basics.rst:1
msgid ""
