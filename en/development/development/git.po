msgstr "``feature/feature-name`` for features."

#: ../../devdocs-source-copy/development/git.rst:80
msgid "``task/task-name`` for tasks."
msgstr "``task/task-name`` for tasks."

#: ../../devdocs-source-copy/development/git.rst:81
msgid "``ticket/12345`` for bugs fixes."
msgstr "``ticket/12345`` for bugs fixes."

#: ../../devdocs-source-copy/development/git.rst:83
msgid ""
"When branches go into the main phpBB repository they are renamed to "
"**<category>/<user>/<name-or-id>**"
